# === API Keys ===
API_KEY=your-client-api-key-here
ADMIN_API_KEY=your-admin-api-key-here

# === OpenAI ===
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

# === PostgreSQL ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=imposter_ai
POSTGRES_USER=imposter
POSTGRES_PASSWORD=changeme

# === JWT ===
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# Then: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_EXPIRE_DAYS=365

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Adapty Webhook ===
# Leave empty to skip signature verification in dev mode
ADAPTY_WEBHOOK_SECRET=

# === App ===
DEBUG=true
LOG_LEVEL=INFO
