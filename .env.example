# === API Keys ===
API_KEY=your-client-api-key-here
ADMIN_API_KEY=your-admin-api-key-here

# === OpenAI ===
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

# === PostgreSQL ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=imposter_ai
POSTGRES_USER=imposter
POSTGRES_PASSWORD=changeme

# === JWT ===
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# Then: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=RS256
JWT_EXPIRE_DAYS=365

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Adapty Webhook (bearer auth, token economy — ADR-002) ===
# Статический bearer-секрет: заголовок "Authorization: Bearer <ADAPTY_WEBHOOK_SECRET>".
# Обязателен в проде. Если пуст — webhook отвечает 500 (НЕ пропускает проверку).
ADAPTY_WEBHOOK_SECRET=

# Тиры подписок: SKU (vendor_product_id) → грант токенов.
# product_id оставьте пустыми, если ещё не заданы реальные SKU в Adapty.
SUBSCRIPTION_PRODUCT_WEEKLY=
SUBSCRIPTION_PRODUCT_YEARLY=
SUBSCRIPTION_TOKENS_WEEKLY=100
SUBSCRIPTION_TOKENS_YEARLY=1500
# Fallback-грант для неизвестного vendor_product_id.
SUBSCRIPTION_TOKENS_GRANT=50

# === AI token spend (ADR-003) ===
# Стоимость одной фактической выдачи AI-слова в POST /ai/generate-theme.
# Списывается атомарно ТОЛЬКО при выдаче AI-слова; на любой fallback не списывается.
AI_THEME_TOKEN_COST=1

# === App ===
DEBUG=true
LOG_LEVEL=INFO
